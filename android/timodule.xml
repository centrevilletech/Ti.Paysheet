<?xml version="1.0" encoding="UTF-8"?>
<ti:module xmlns:ti="http://ti.tidev.io" xmlns:android="http://schemas.android.com/apk/res/android">
	<android xmlns:android="http://schemas.android.com/apk/res/android">
		<manifest>
			<application>
				<!--
					Invisible activity that hosts Stripe's PaymentSheet / CustomerSheet. Stripe requires the sheet to be
					created while an activity is created; it is deliberately allowed to be recreated on rotation.
				-->
				<activity
					android:name="ti.paysheet.PaysheetHostActivity"
					android:exported="false"
					android:theme="@android:style/Theme.Translucent.NoTitleBar" />
			</application>
		</manifest>
	</android>
</ti:module>
